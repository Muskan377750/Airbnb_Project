<%- layout("/layouts/boilerplate") %>
<div class="row mt-3">
    <div class="col-8 offset-2">
    <h3>Create a New Listing:</h3>
    <form action="/listings" method="POST" class="needs-validation" novalidate enctype="multipart/form-data">
        <div class="mb-3">
             <label for="title" class="form-label">Title</label>
             <input type="text" name="listing[title]" placeholder="Add a catchy title" class="form-control" required>
             <div class="invalid-feedback">Please provide a valid title!</div>
             <div class="valid-feedback">That's a good Title!</div>
        </div>
       
        <div class="mb-3">
             <label for="description" class="form-label">Description</label>
             <textarea name="listing[description]" class="form-control" placeholder="Enter description" required></textarea>
             <div class="invalid-feedback">Please provide a valid short description!</div>
             <div class="valid-feedback">Well-written and highlights the space nicely.</div>
        </div>

        <div class="row">
        <div class="mb-3 col-md-8">
         <label for="image" class="form-label">Upload Listing Image</label>
         <input type="file" name="listing[image]" class="form-control" required>
        </div>
        <div class="mb-3 col-md-4">
            <label for="category" class="form label">Category</label>
            <select name="listing[category]" id="category" class="form-select" required>
                <option value="" disabled selected>Choose a category</option>
                <option value="Trending">🔥Trending</option>
                <option value="Rooms">🏡 Rooms</option>
                <option value="Iconic Cities">🏙️ Iconic Cities</option>
                <option value="Mountains">⛰️ Mountains</option>
                <option value="Castles">🏰 Castles</option>
                <option value="Amazing Pools">🏊 Amazing Pools</option>
                <option value="Camping">🏕️ Camping</option>
                <option value="Farms">🐄 Farms</option>
                <option value="Arctic">🏂 Arctic</option>
                <option value="Top of the world">🔝 Top of the world</option>
                <option value="Bed & Breakfasts">🛏️ Bed & Breakfasts</option>
                <option value="Vineyards">🍇 Vineyards</option>
                <option value="Domes">🏘️ Domes</option>
                <option value="Designs">🎨 Designs</option>
                <option value="A Frames">🛖 A Frames</option>
            </select>
        </div>
        </div>
        

        <div class="row">
        <div class="mb-3 col-md-4">
         <label for="price" class="form-label">Price</label>  
         <input type="number" class="form-control" name="listing[price]" placeholder="1200" required>
         <div class="invalid-feedback">Please provide a valid price!</div>
         <div class="valid-feedback">Great value for money.</div>
        </div>

        <div class="mb-3 col-md-8">
         <label for="country" class="form-label">Country</label>    
         <input type="text" class="form-control" name="listing[country]" placeholder="India" required>
         <div class="invalid-feedback">Please enter a valid country!</div>
         <div class="valid-feedback">Great country location.</div>
        </div>
        </div>

        <div class="mb-3">
         <label for="location" class="form-label">Location</label> 
         <input type="text" name="listing[location]" placeholder="Jaipur, Rajasthan" class="form-control" required>
         <div class="invalid-feedback">Please enter a valid location!</div>
         <div class="valid-feedback">Location enhances the overall appeal.</div>
        </div>
        
        <button class="btn btn-dark add-btn mt-2 mb-3 ">Add</button>
       
    </form>
</div>
</div>